@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
if not exist "%~dp0support\installer101\BuildAndRun.ps1" (
 echo [오류] 분할 ZIP 전체를 같은 새 폴더에 풀고 그 폴더의 설치.cmd 를 실행해 주세요.
 echo        support\installer101\BuildAndRun.ps1 가 없습니다. 2번째 이후 ZIP 을 안 풀었거나 백신이 지웠을 수 있습니다.
 pause
 exit /b 1
)
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0support\installer101\BuildAndRun.ps1"
if errorlevel 1 (
 echo.
 echo [오류] 설치기를 시작하지 못했습니다. 방금 뜬 오류 창의 글자를 복사해 알려 주세요. (support\installer101\BUILD_ERROR.txt 에도 남습니다)
 pause
 exit /b 1
)
exit /b 0
